{
  "name": "@arise/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "start": "pnpm native:electron && electron .",
    "native:electron": "electron-rebuild -f -w better-sqlite3",
    "native:node": "pnpm --filter @arise/database rebuild better-sqlite3",
    "test:e2e": "pnpm build && pnpm native:electron && playwright test"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "@arise/domain": "workspace:*",
    "@arise/database": "workspace:*",
    "@arise/shared": "workspace:*",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.4",
    "@arise/charting": "workspace:*",
    "@arise/documents": "workspace:*",
    "@arise/calendar": "workspace:*",
    "@arise/strategy-engine": "workspace:*",
    "@arise/evidence": "workspace:*"
    ,"@arise/execution": "workspace:*"
  },
  "devDependencies": {
    "@arise/mt5-agent": "workspace:*",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "esbuild": "^0.25.9",
    "@electron/rebuild": "^4.0.1",
    "@playwright/test": "^1.55.0"
  }
}
