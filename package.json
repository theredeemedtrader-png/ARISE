{
  "name": "arise",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @arise/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "check": "pnpm --filter @arise/desktop native:node && pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "pnpm --filter @arise/database db:generate",
    "test:e2e": "pnpm --filter @arise/desktop test:e2e"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "typescript-eslint": "^8.42.0"
  }
}
